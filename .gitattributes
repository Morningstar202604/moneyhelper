* text=auto eol=lf

# Windows 脚本必须是 CRLF：cmd.exe 对 LF 结尾的 .bat 解析会截断行首字符
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Unix 脚本保持 LF 且保留可执行位（Windows 检出时依赖 git 记录的 100755）
*.sh     text eol=lf

# 二进制文件
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.svg    text
*.pdf    binary
*.zip    binary
*.apk    binary
*.jar    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.mov    binary
*.mp4    binary
*.webm   binary
*.db     binary
*.sqlite binary

# 语言统计（避免生成物污染 linguist）
*.lock   linguist-generated=true
