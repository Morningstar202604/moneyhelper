# 复制为 .env 后按需填写。全部可选：不配置也能跑（确定性模板兜底）。

# 模型（基于 LiteLLM 统一接入，自动故障转移 + 成本追踪）：
#   DeepSeek  https://api.deepseek.com/v1          model: deepseek-chat
#   豆包      https://ark.cn-beijing.volces.com/api/v3   model: 推理接入点 ID
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
#   OpenAI    https://api.openai.com/v1             model: gpt-4o-mini
#   Anthropic https://api.anthropic.com/v1          model: claude-3-5-sonnet-latest
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai  model: gemini-2.0-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# 访问口令：留空 = 不鉴权（仅限本机/内网使用）；设置后所有 /api/* 需带
# Authorization: Bearer <口令> 或 ?token=<口令>，前端首次访问会提示输入。
API_TOKEN=

# 加密数据库敏感字段（ai_api_key）的启动口令。不设置则敏感字段落库时不加密
# （明文存储，仅适合纯本机使用场景）。8 位以上，首次设置后勿改——改了无法解密旧数据。
# VAULT_PASSPHRASE=

# MCP Server：=1 启动时挂载 /mcp 路径（Streamable HTTP），任何 MCP Client 可接入小满工具集。
# 设 =0 关闭（纯本机不需要对外暴露 MCP 时）。默认开启。
MCP_ENABLE=1

# 未设 API_TOKEN 时，额外允许访问的 Host（逗号分隔，默认只放行本机）。
# 例：按局域网主机名访问写 nas.local；需要对外网暴露请直接设 API_TOKEN。
# ALLOWED_HOSTS=nas.local,10.0.0.5

# 调试用：仅放行前端开发源。生产同域托管无需改动。
# CORS_ALLOW_ALL=1

# 数据目录：默认 backend/data/（指向 wealth.db 所在路径 + backups/wal 日志所在路径）。
# XIAOMAN_DB_PATH=/abs/path/to/wealth.db
